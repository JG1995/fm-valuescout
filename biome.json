{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!src/routeTree.gen.ts", "!bridge"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/routes/**/*$*.tsx", "src/app/routes/**/*$*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "App shell is not importable from features — compose in app/routes."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Do not import across features — use relative imports within a feature or compose in app/routes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/config/**",
        "src/hooks/**",
        "src/lib/**",
        "src/types/**",
        "src/utils/**",
        "src/stores/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "Shared code must not import the app shell."
                  },
                  {
                    "group": ["@/features/**"],
                    "message": "Shared code must not import features — lift code up or compose in app/routes."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
