#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
dump_path=""

if [[ "$#" -eq 0 ]]; then
  :
elif [[ "$#" -eq 1 && "$1" == "--dump" ]]; then
  printf 'ui-agent requires an absolute dump path after --dump.\n' >&2
  exit 2
elif [[ "$#" -ne 2 || "$1" != "--dump" ]]; then
  printf 'ui-agent accepts only --dump /absolute/path/dump.json.\n' >&2
  exit 2
elif [[ "$2" != /* ]]; then
  printf 'ui-agent requires an absolute dump path.\n' >&2
  exit 2
elif [[ ! -f "$2" || ! -r "$2" ]]; then
  printf 'ui-agent requires a readable dump file: %s\n' "$2" >&2
  exit 2
else
  dump_path="$2"
fi

profile_root="$(cd -- "${TMPDIR:-/tmp}" && pwd -P)"
profile_dir="$(mktemp -d "$profile_root/fm-valuescout-ui-agent.XXXXXX")"

cleanup_profile() {
  local status="$?"
  trap - EXIT

  if [[ -d "$profile_dir" ]]; then
    if [[ "$(dirname -- "$profile_dir")" != "$profile_root" || \
      "$(basename -- "$profile_dir")" != fm-valuescout-ui-agent.* ]]; then
      printf 'Refusing to clean unexpected UI-agent profile: %s\n' "$profile_dir" >&2
      exit 1
    fi

    if ! rm -r -- "$profile_dir"; then
      printf 'Failed to clean UI-agent profile: %s\n' "$profile_dir" >&2
      exit 1
    fi
  fi

  exit "$status"
}

trap cleanup_profile EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

export FM_VALUESCOUT_UI_AGENT=1
export FM_VALUESCOUT_UI_AGENT_DATA_DIR="$profile_dir"
unset FM_VALUESCOUT_UI_AGENT_DUMP
unset FM_VALUESCOUT_UI_AGENT_WSL

if [[ -r /proc/sys/kernel/osrelease ]]; then
  read -r ui_agent_kernel_release < /proc/sys/kernel/osrelease
  if [[ "${ui_agent_kernel_release,,}" == *microsoft* ]]; then
    export FM_VALUESCOUT_UI_AGENT_WSL=1
  fi
fi

if [[ -n "$dump_path" ]]; then
  export FM_VALUESCOUT_UI_AGENT_DUMP="$dump_path"
fi

printf 'Starting UI-agent session with temporary profile: %s\n' "$profile_dir"
(
  cd "$repo_root"
  pnpm tauri dev --features ui-agent --config src-tauri/tauri.ui-agent.conf.json
)
