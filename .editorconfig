root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# rustfmt default; keep EditorConfig aligned so editors do not force 2-space Rust.
[*.rs]
indent_size = 4

[Makefile]
indent_style = tab
