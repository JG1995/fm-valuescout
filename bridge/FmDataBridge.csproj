<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FmDataBridge</AssemblyName>
    <Product>FM ValueScout Data Bridge</Product>
    <Version>0.14.3</Version>
    <BepInExPluginGuid>com.fmvaluescout.databridge</BepInExPluginGuid>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FmDataBridge</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="[6.0.0-be.785]" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="[2.1.0]" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FmDataBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <!--
    InteropDir (from Directory.Build.user.props) is reserved for FM Il2CppInterop
    assemblies in later memory-scan commits. Status scaffold does not reference them.
  -->
</Project>
