<!--
  Copy to Directory.Build.user.props (gitignored) and set paths for your machine.

  BepInExCore  — folder with BepInEx.Core.dll (and related BepInEx / Harmony refs)
  InteropDir   — folder with Il2CppInterop-generated assemblies (first FM launch with BepInEx)

  Do not commit Directory.Build.user.props. Do not vendor these DLLs into git.
-->
<Project>
  <PropertyGroup>
    <!-- Example Steam layout — replace with your install -->
    <FmSteamRoot>C:\Program Files (x86)\Steam\steamapps\common\Football Manager 26</FmSteamRoot>
    <BepInExCore>$(FmSteamRoot)\BepInEx\core</BepInExCore>
    <InteropDir>$(FmSteamRoot)\BepInEx\interop</InteropDir>
  </PropertyGroup>
</Project>
